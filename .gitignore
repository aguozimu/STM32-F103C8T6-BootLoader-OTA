# ===========================================================================
# STM32F103C8T6 BootLoader + OTA —— Git 忽略规则
#
# 原则：只提交源码、工程配置与最终固件（*.hex）；
#       编译中间产物、调试残留、编辑器与操作系统的临时文件一律忽略。
# ===========================================================================

# --- 编辑器 / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- 操作系统 ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Keil MDK-ARM 编译中间产物 ---
*.o
*.crf
*.d
*.lst
*.lnp
*.dep
*.iex
*.sct
*.map
*.axf
*.htm
*.__i

# --- CMake / GCC 编译输出目录 ---
build/
cmake-build-*/

# --- 两个工程的 Keil 运行时目录（锚定到 MDK-ARM，避免误伤
#     Drivers/CMSIS 第三方库中自带的 RTE 目录）---
/APP/APP/MDK-ARM/RTE/
/APP/APP/MDK-ARM/DebugConfig/
/bootloader/bootloader/MDK-ARM/RTE/
/bootloader/bootloader/MDK-ARM/DebugConfig/

# --- Keil 用户相关文件 ---
*.uvguix.*

# --- 调试器日志 ---
JLinkLog.txt
JLinkSettings.ini

# --- 通用临时文件 ---
*.tmp
*.bak
*.orig
*.rej

# --- 说明 ---
# 最终固件（APP.hex / bootloader.hex）仍纳入版本管理，方便直接取用。
# 如希望连固件一起忽略，取消下面注释并执行：
#   git rm --cached APP/APP/MDK-ARM/APP/APP.hex bootloader/bootloader/MDK-ARM/bootloader/bootloader.hex
# *.hex
